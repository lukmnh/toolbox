<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lukmnh.toolbox</groupId>
        <artifactId>toolbox-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>tool-devutils</artifactId>
    <name>Toolbox :: Tool DevUtils</name>
    <description>JWT Debugger, Encoder/Decoder, Hash Generator, Checksum, Text Diff, Regex Tester, SQL Formatter, dan Cron Builder.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lukmnh.toolbox</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- Pretty-print header/payload JWT dan parsing JWK; streaming saja, tanpa databind -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <!-- Text Diff: algoritma Myers (linear space) untuk diff baris dan kata -->
        <dependency>
            <groupId>io.github.java-diff-utils</groupId>
            <artifactId>java-diff-utils</artifactId>
        </dependency>
        <!-- Regex flavor Go: port resmi RE2 (sintaks & semantik sama dengan paket regexp Go) -->
        <dependency>
            <groupId>com.google.re2j</groupId>
            <artifactId>re2j</artifactId>
        </dependency>
        <!-- SQL Formatter: format multi-dialect (tanpa dependency runtime). Minify memakai tokenizer sendiri -->
        <dependency>
            <groupId>com.github.vertical-blank</groupId>
            <artifactId>sql-formatter</artifactId>
        </dependency>
        <!-- Cron: parse/validasi per target + jadwal berikutnya. Versi terbaru (versi lama punya CVE) -->
        <dependency>
            <groupId>com.cronutils</groupId>
            <artifactId>cron-utils</artifactId>
        </dependency>
    </dependencies>
</project>
